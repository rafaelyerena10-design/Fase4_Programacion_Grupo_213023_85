    # Importamos ABC y abstractmethod para definir clases y métodos abstractos en Python
from abc import ABC, abstractmethod
# Importamos las excepciones personalizadas y la clase base del proyecto
from excepciones import DatosInvalidosError
from entidades import EntidadSistema


# ==============================================================================
# CLASE ABSTRACTA: Servicio
# ==============================================================================
class Servicio(EntidadSistema, ABC):
    """
    Clase abstracta que representa un servicio genérico ofrecido por Software FJ.
    Define la estructura base para el cálculo de costos, validaciones y descripciones.
    """

    def __init__(self, id_servicio: str, nombre: str, tarifa_base: float, disponible: bool = True):
        # Llamamos al constructor de la clase padre (EntidadSistema) para validar el ID
        super().__init__(id_servicio)
        
        # Validamos que el nombre del servicio no esté vacío
        if not nombre or not nombre.strip():
            raise DatosInvalidosError("El nombre del servicio no puede estar vacío.")
        
        # Validamos que la tarifa base sea un valor numérico positivo
        if tarifa_base <= 0:
            raise DatosInvalidosError(f"La tarifa base (${tarifa_base}) debe ser mayor a cero.")
        
        # Asignamos los atributos protegidos (encapsulación)
        self._nombre = nombre.strip()
        self._tarifa_base = float(tarifa_base)
        self.disponible = disponible

    # Propiedades (Getters) para acceder de forma segura a los atributos encapsulados
    @property
    def nombre(self) -> str:
        return self._nombre

    @property
    def tarifa_base(self) -> float:
        return self._tarifa_base

    # Métodos abstractos que OBLIGATORIAMENTE deben sobrescribir las clases hijas
    @abstractmethod
    def validar_parametros(self, duracion: int) -> None:
        """Valida las reglas específicas de duración o uso de cada servicio."""
        pass

    @abstractmethod
    def describir_servicio(self) -> str:
        """Retorna una descripción detallada y personalizada del servicio."""
        pass

    # Método base para calcular costos (permite sobrecarga mediante parámetros opcionales)
    def calcular_costo(self, duracion: int, impuesto: float = 0.19, descuento: float = 0.0) -> float:
        """
        Calcula el costo total del servicio aplicando impuestos y descuentos opcionales.
        """
        # Primero ejecutamos la validación polimórfica propia de cada servicio
        self.validar_parametros(duracion)
        
        # Validamos que el descuento esté en un rango lógico (0% a 100%)
        if not (0.0 <= descuento <= 1.0):
            raise DatosInvalidosError("El descuento debe ser un valor entre 0.0 y 1.0.")
        
        # Validamos que el impuesto no sea negativo
        if impuesto < 0:
            raise DatosInvalidosError("El impuesto no puede ser un valor negativo.")

        # Calculamos subtotal, aplicamos descuento y sumamos el impuesto
        subtotal = self._tarifa_base * duracion
        subtotal_con_descuento = subtotal * (1 - descuento)
        total = subtotal_con_descuento * (1 + impuesto)
        
        # Retornamos el valor redondeado a 2 decimales
        return round(total, 2)

    # Implementación del método abstracto heredado de EntidadSistema
    def obtener_resumen(self) -> str:
        estado = "Disponible" if self.disponible else "No disponible"
        return f"[{self.id}] {self.describir_servicio()} | Estado: {estado}"


