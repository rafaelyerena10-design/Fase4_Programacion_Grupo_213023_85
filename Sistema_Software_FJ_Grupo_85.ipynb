# SERVICIO ESPECIALIZADO 3: Asesoría Especializada
# ==============================================================================
class AsesoriaEspecializada(Servicio):
    """Servicio especializado de consultoría técnica con profesionales de Software FJ."""

    def __init__(self, id_servicio: str, nombre: str, tarifa_hora: float, especialidad: str, nivel_senior: bool = False, disponible: bool = True):
        # Inicializamos atributos base
        super().__init__(id_servicio, nombre, tarifa_hora, disponible)
        
        # Validamos la especialidad técnica
        if not especialidad or not especialidad.strip():
            raise DatosInvalidosError("Debe especificar el área de especialidad de la asesoría.")
        self._especialidad = especialidad.strip()
        self._nivel_senior = nivel_senior

    # Sobrescritura de validación: las asesorías se agendan en bloques de 1 a 4 horas por día
    def validar_parametros(self, duracion: int) -> None:
        if not isinstance(duracion, int) or duracion < 1 or duracion > 4:
            raise DatosInvalidosError(f"Duración inválida ({duracion}h). Las asesorías permiten entre 1 y 4 horas por sesión.")

    # Sobrescritura de descripción
    def describir_servicio(self) -> str:
        nivel = "Senior" if self._nivel_senior else "Estándar"
        return f"Asesoría {nivel} en {self._especialidad}: '{self._nombre}' - ${self._tarifa_base:,.2f}/hora"

    # Sobrescritura polimórfica de costo: si el consultor es Senior, se aplica un recargo del 25% antes de impuestos
    def calcular_costo(self, duracion: int, impuesto: float = 0.19, descuento: float = 0.0) -> float:
        costo_base = super().calcular_costo(duracion, impuesto, descuento)
        if self._nivel_senior:
            return round(costo_base * 1.25, 2)
        return costo_base

