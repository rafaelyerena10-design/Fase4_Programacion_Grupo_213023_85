# SERVICIO ESPECIALIZADO 1: Reserva de Salas
# ==============================================================================
class ReservaSala(Servicio):
    """Servicio especializado para el alquiler de salas de reuniones o capacitación."""

    def __init__(self, id_servicio: str, nombre: str, tarifa_hora: float, capacidad: int, disponible: bool = True):
        # Inicializamos los atributos comunes en la clase padre Servicio
        super().__init__(id_servicio, nombre, tarifa_hora, disponible)
        
        # Validamos el atributo específico de este servicio (capacidad de personas)
        if capacidad <= 0:
            raise DatosInvalidosError("La capacidad de la sala debe ser mayor a 0 personas.")
        self._capacidad = capacidad

    # Sobrescritura de validación: las salas se reservan entre 1 y 12 horas máximo
    def validar_parametros(self, duracion: int) -> None:
        if not isinstance(duracion, int) or duracion < 1 or duracion > 12:
            raise DatosInvalidosError(f"Duración inválida ({duracion}h). Las salas se reservan entre 1 y 12 horas.")

    # Sobrescritura de descripción
    def describir_servicio(self) -> str:
        return f"Sala '{self._nombre}' (Capacidad: {self._capacidad} personas) - ${self._tarifa_base:,.2f}/hora"

    # Sobrescritura polimórfica de costo: si se reserva por más de 6 horas, aplica 5% de descuento extra por jornada completa
    def calcular_costo(self, duracion: int, impuesto: float = 0.19, descuento: float = 0.0) -> float:
        descuento_total = descuento + 0.05 if duracion > 6 else descuento
        # Evitamos que el descuento total supere el 100% (1.0)
        descuento_total = min(descuento_total, 1.0)
        return super().calcular_costo(duracion, impuesto, descuento_total)


