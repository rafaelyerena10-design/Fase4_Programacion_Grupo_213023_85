# SERVICIO ESPECIALIZADO 2: Alquiler de Equipos
# ==============================================================================
class AlquilerEquipo(Servicio):
    """Servicio especializado para el préstamo de hardware o equipos tecnológicos."""

    def __init__(self, id_servicio: str, nombre: str, tarifa_dia: float, serial: str, deposito_seguridad: float = 50000.0, disponible: bool = True):
        # Inicializamos atributos base
        super().__init__(id_servicio, nombre, tarifa_dia, disponible)
        
        # Validamos que el equipo tenga un número de serie válido
        if not serial or not serial.strip():
            raise DatosInvalidosError("El equipo debe tener un número de serie válido.")
        self._serial = serial.strip()
        self._deposito_seguridad = deposito_seguridad

    # Sobrescritura de validación: el alquiler de equipos se mide en días (mínimo 1, máximo 30)
    def validar_parametros(self, duracion: int) -> None:
        if not isinstance(duracion, int) or duracion < 1 or duracion > 30:
            raise DatosInvalidosError(f"Duración inválida ({duracion} días). El alquiler es de 1 a 30 días.")

    # Sobrescritura de descripción
    def describir_servicio(self) -> str:
        return f"Equipo '{self._nombre}' [Serial: {self._serial}] - ${self._tarifa_base:,.2f}/día"

    # Sobrescritura polimórfica de costo: suma un depósito de seguridad fijo al costo calculado
    def calcular_costo(self, duracion: int, impuesto: float = 0.19, descuento: float = 0.0) -> float:
        costo_base = super().calcular_costo(duracion, impuesto, descuento)
        return round(costo_base + self._deposito_seguridad, 2)


