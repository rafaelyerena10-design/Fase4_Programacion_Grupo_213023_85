    "# ==============================================================================\n",
    "# UNIVERSIDAD NACIONAL ABIERTA Y A DISTANCIA (UNAD)\n",
    "# Curso: Programación - Código: 213023\n",
    "# Grupo: 213023_85\n",
    "# Fase 4 - Componente práctico - Prácticas simuladas\n",
    "# Ejercicio 1: Sistema Integral de Gestión de Clientes, Servicios y Reservas\n",
    "# Empresa: Software FJ\n",
    "# ==============================================================================\n",
    "# MÓDULO 1 (Aporte Individual - Estudiante 1):\n",
    "# Desarrollado por: RAFAEL ANTONIO LLERENA PEREZ\n",
    "# Contenido del módulo:\n",
    "# 1. Listas internas en memoria y manejo de archivo de logs (.txt)\n",
    "# 2. Excepciones personalizadas del sistema\n",
    "# 3. Clase abstracta general (EntidadSistema)\n",
    "# 4. Clase Cliente con encapsulación y validaciones estrictas\n",
    "# 5. Simulaciones 1 y 2 (Registro válido e inválido con manejo de excepciones)\n",
    "# ==============================================================================\n",
    "\n",
    "from abc import ABC, abstractmethod\n",
    "from datetime import datetime\n",
    "\n",
    "ARCHIVO_LOGS = \"logs_software_fj.txt\"\n",
    "\n",
    "lista_clientes = []\n",
    "lista_servicios = []\n",
    "lista_reservas = []\n",
    "\n",
    "# ==============================================================================\n",
    "# 1. FUNCIÓN PARA EL MANEJO DEL ARCHIVO DE LOGS\n",
    "# ==============================================================================\n",
    "def registrar_log(tipo_evento, descripcion):\n",
    "    try:\n",
    "        fecha_hora = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n",
    "        linea = f\"[{fecha_hora}] [{tipo_evento}] - {descripcion}\\n\"\n",
    "        with open(ARCHIVO_LOGS, \"a\", encoding=\"utf-8\") as archivo:\n",
    "            archivo.write(linea)\n",
    "    except IOError as error_io:\n",
    "        print(f\"Advertencia: No se pudo escribir en el archivo de logs ({error_io})\")\n",
    "\n",
    "# ==============================================================================\n",
    "# 2. DEFINICIÓN DE EXCEPCIONES PERSONALIZADAS\n",
    "# ==============================================================================\n",
    "class SoftwareFJError(Exception):\n",
    "    def __init__(self, mensaje):\n",
    "        super().__init__(mensaje)\n",
    "\n",
    "class ClienteInvalidoError(SoftwareFJError):\n",
    "    pass\n",
    "\n",
    "class ParametroFaltanteError(SoftwareFJError):\n",
    "    pass\n",
    "\n",
    "class ServicioNoDisponibleError(SoftwareFJError):\n",
    "    pass\n",
    "\n",
    "class ReservaInvalidaError(SoftwareFJError):\n",
    "    pass\n",
    "\n",
    "class CalculoInconsistenteError(SoftwareFJError):\n",
    "    pass\n",
    "\n",
    "# ==============================================================================\n",
    "# 3. CLASE ABSTRACTA GENERAL (EntidadSistema)\n",
    "# ==============================================================================\n",
    "class EntidadSistema(ABC):\n",
    "    def __init__(self, id_entidad):\n",
    "        self._id_entidad = id_entidad\n",
    "        self._fecha_creacion = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n",
    "\n",
    "    def get_id_entidad(self):\n",
    "        return self._id_entidad\n",
    "\n",
    "    @abstractmethod\n",
    "    def validar_datos(self):\n",
    "        pass\n",
    "\n",
    "    @abstractmethod\n",
    "    def mostrar_informacion(self):\n",
    "        pass\n",
    "\n",
    "# ==============================================================================\n",
    "# 4. CLASE CLIENTE\n",
    "# ==============================================================================\n",
    "class Cliente(EntidadSistema):\n",
    "    def __init__(self, id_cliente, nombre, correo, telefono):\n",
    "        super().__init__(id_cliente)\n",
    "        self.__nombre = nombre\n",
    "        self.__correo = correo\n",
    "        self.__telefono = telefono\n",
    "        self.validar_datos()\n",
    "\n",
    "    def get_nombre(self):\n",
    "        return self.__nombre\n",
    "\n",
    "    def set_nombre(self, nuevo_nombre):\n",
    "        if nuevo_nombre is None or str(nuevo_nombre).strip() == \"\":\n",
    "            raise ParametroFaltanteError(\"El nombre del cliente es un parametro obligatorio y no puede estar vacio.\")\n",
    "        self.__nombre = str(nuevo_nombre).strip()\n",
    "\n",
    "    def get_correo(self):\n",
    "        return self.__correo\n",
    "\n",
    "    def set_correo(self, nuevo_correo):\n",
    "        if nuevo_correo is None or str(nuevo_correo).strip() == \"\":\n",
    "            raise ParametroFaltanteError(\"El correo electronico del cliente es obligatorio.\")\n",
    "        correo_texto = str(nuevo_correo).strip()\n",
    "        if \"@\" not in correo_texto or \".\" not in correo_texto:\n",
    "            raise ClienteInvalidoError(f\"El correo '{correo_texto}' no tiene un formato valido (debe contener '@' y '.').\")\n",
    "        self.__correo = correo_texto\n",
    "\n",
    "    def get_telefono(self):\n",
    "        return self.__telefono\n",
    "\n",
    "    def set_telefono(self, nuevo_telefono):\n",
    "        if nuevo_telefono is None or str(nuevo_telefono).strip() == \"\":\n",
    "            raise ParametroFaltanteError(\"El numero de telefono del cliente es obligatorio.\")\n",
    "        telefono_texto = str(nuevo_telefono).strip()\n",
    "        if not telefono_texto.isdigit() or len(telefono_texto) < 7:\n",
    "            raise ClienteInvalidoError(f\"El telefono '{telefono_texto}' es invalido (debe tener solo numeros y minimo 7 digitos).\")\n",
    "        self.__telefono = telefono_texto\n",
    "\n",
    "    def validar_datos(self):\n",
    "        if self._id_entidad is None or str(self._id_entidad).strip() == \"\":\n",
    "            raise ParametroFaltanteError(\"El documento o ID del cliente es obligatorio.\")\n",
    "        self.set_nombre(self.__nombre)\n",
    "        self.set_correo(self.__correo)\n",
    "        self.set_telefono(self.__telefono)\n",
    "\n",
    "    def mostrar_informacion(self):\n",
    "        return f\"Cliente [ID: {self._id_entidad} | Nombre: {self.__nombre} | Correo: {self.__correo} | Teléfono: {self.__telefono}]\"\n",
    "\n",
    "def registrar_cliente(id_cliente, nombre, correo, telefono):\n",
    "    print(f\"\\n>>> Procesando solicitud de registro para el cliente: {nombre} (ID: {id_cliente})\")\n",
    "    try:\n",
    "        for cliente_actual in lista_clientes:\n",
    "            if str(cliente_actual.get_id_entidad()) == str(id_cliente).strip():\n",
    "                raise ValueError(f\"El ID '{id_cliente}' ya se encuentra asignado a otro cliente en la lista.\")\n",
    "        nuevo_cliente = Cliente(id_cliente, nombre, correo, telefono)\n",
    "    except (ParametroFaltanteError, ClienteInvalidoError) as error_validacion:\n",
    "        print(f\"[ERROR CONTROLADO]: {error_validacion}\")\n",
    "        registrar_log(\"ERROR_VALIDACION\", f\"Fallo en registro de cliente ID '{id_cliente}': {error_validacion}\")\n",
    "        return None\n",
    "    except ValueError as error_origen:\n",
    "        try:\n",
    "            raise ClienteInvalidoError(\"Operacion rechazada por duplicidad de cliente en el sistema.\") from error_origen\n",
    "        except ClienteInvalidoError as error_encadenado:\n",
    "            print(f\"[ERROR ENCADENADO]: {error_encadenado}\")\n",
    "            print(f\" -> Causa original del error: {error_encadenado.__cause__}\")\n",
    "            registrar_log(\"ERROR_ENCADENADO\", f\"{error_encadenado} | Causa: {error_encadenado.__cause__}\")\n",
    "            return None\n",
    "    else:\n",
    "        lista_clientes.append(nuevo_cliente)\n",
    "        print(f\"[REGISTRO EXITOSO]: {nuevo_cliente.mostrar_informacion()}\")\n",
    "        registrar_log(\"EVENTO_CLIENTE\", f\"Registro exitoso: {nuevo_cliente.mostrar_informacion()}\")\n",
    "        return nuevo_cliente\n",
    "    finally:\n",
    "        print(f\"[FIN DE OPERACIÓN]: Clientes válidos almacenados en memoria: {len(lista_clientes)}\")\n",
    "\n",
    "print(\"======================================================================\")\n",
    "print(\" INICIO DE SIMULACIONES - SISTEMA SOFTWARE FJ (GRUPO 213023_85)\")\n",
    "print(\"======================================================================\")\n",
    "registrar_log(\"INICIO_SISTEMA\", \"Se inicia la ejecucion del Sistema de Gestion Software FJ.\")\n",
    "\n",
    "print(\"\\n--- SIMULACIÓN 1: Registro de Cliente Válido ---\")\n",
    "cliente_1 = registrar_cliente(\"1001\", \"Rafael Antonio Llerena Perez\", \"rllerenap@unadvirtual.edu.co\", \"3004567890\")\n",
    "\n",
    "print(\"\\n--- SIMULACIÓN 2A: Registro de Cliente Inválido (Correo sin formato válido) ---\")\n",
    "cliente_invalido_1 = registrar_cliente(\"1002\", \"Carlos Mendoza\", \"carlos_mendoza_correo_malo.com\", \"3109876543\")\n",
    "\n",
    "print(\"\\n--- SIMULACIÓN 2B: Registro de Cliente Inválido (ID duplicado) ---\")\n",
    "cliente_invalido_2 = registrar_cliente(\"1001\", \"Usuario Duplicado\", \"duplicado@correo.com\", \"3201112233\")\n",
    "\n",
    "# ==============================================================================\n",
    "# ESPACIOS RESERVADOS PARA EL DESARROLLO COLABORATIVO DE LOS COMPAÑEROS\n",
    "# ==============================================================================\n",
    "\n",
    "# ------------------------------------------------------------------------------\n",
    "# MÓDULO 2 (ESPACIO PARA ESTUDIANTE 2): FABRICIO JOSÉ ESCOBAR OSPINO\n",
    "# - Crear la Clase Abstracta 'Servicio' (que herede de EntidadSistema) con métodos abstractos para calcular costos, describir servicios y validar parámetros.\n",
    "# - Crear la Clase hija 'ReservaSala' (herencia y polimorfismo).\n",
    "# - Realizar las Simulaciones 3 y 4 (creación correcta e incorrecta de ReservaSala).\n",
    "# ------------------------------------------------------------------------------\n",
    "# (Escribir código del Estudiante 2 aquí debajo)\n",
    "\n",
    "# Clase abstracta Servicio que hereda de EntidadSistema\n",
    "class Servicio(EntidadSistema):\n",
    "\n",
    "    def __init__(self, id_servicio, nombre, descripcion, precio_base):\n",
    "        super().__init__(id_servicio)\n",
    "        self._nombre = nombre\n",
    "        self._descripcion = descripcion\n",
    "        self._precio_base = precio_base\n",
    "\n",
    "    # Método para validar los datos generales del servicio\n",
    "    def validar_datos(self):\n",
    "\n",
    "        if self._id_entidad is None or str(self._id_entidad).strip() == \"\":\n",
    "            raise ParametroFaltanteError(\"El ID del servicio es obligatorio.\")\n",
    "\n",
    "        if self._nombre is None or str(self._nombre).strip() == \"\":\n",
    "            raise ParametroFaltanteError(\"El nombre del servicio es obligatorio.\")\n",
    "\n",
    "        if self._descripcion is None or str(self._descripcion).strip() == \"\":\n",
    "            raise ParametroFaltanteError(\"La descripción del servicio es obligatoria.\")\n",
    "\n",
    "        if not isinstance(self._precio_base, (int, float)) or isinstance(self._precio_base, bool) or self._precio_base <= 0:\n",
    "            raise CalculoInconsistenteError(\"El precio base debe ser un número mayor que cero.\")\n",
    "\n",
    "        self.validar_parametros()\n",
    "\n",
    "    # Métodos abstractos que deben implementar las clases hijas\n",
    "    @abstractmethod\n",
    "    def calcular_costo(self, duracion=1, impuesto=0, descuento=0):\n",
    "        pass\n",
    "\n",
    "    @abstractmethod\n",
    "    def describir_servicio(self):\n",
    "        pass\n",
    "\n",
    "    @abstractmethod\n",
    "    def validar_parametros(self):\n",
    "        pass\n",
    "\n",
    "    # Método auxiliar para aplicar impuestos y descuentos\n",
    "    def aplicar_ajustes(self, costo_base, impuesto=0, descuento=0):\n",
    "\n",
    "        if not isinstance(impuesto, (int, float)) or isinstance(impuesto, bool) or impuesto < 0 or impuesto > 100:\n",
    "            raise CalculoInconsistenteError(\"El impuesto debe estar entre 0 y 100.\")\n",
    "\n",
    "        if not isinstance(descuento, (int, float)) or isinstance(descuento, bool) or descuento < 0 or descuento > 100:\n",
    "            raise CalculoInconsistenteError(\"El descuento debe estar entre 0 y 100.\")\n",
    "\n",
    "        costo_con_descuento = costo_base - (costo_base * descuento / 100)\n",
    "\n",
    "        costo_final = costo_con_descuento + (costo_con_descuento * impuesto / 100)\n",
    "\n",
    "        return round(costo_final, 2)\n",
    "\n",
    "    # Método para mostrar información general\n",
    "    def mostrar_informacion(self):\n",
    "        return (\n",
    "            f\"Servicio [ID: {self._id_entidad} | \"\n",
    "            f\"Nombre: {self._nombre} | \"\n",
    "            f\"Descripción: {self._descripcion} | \"\n",
    "            f\"Precio base: ${self._precio_base}]\"\n",
    "        )\n",
    "\n",
    "\n",
    "# Clase ReservaSala que hereda de Servicio\n",
    "class ReservaSala(Servicio):\n",
    "\n",
    "    def __init__(self, id_servicio, nombre, descripcion, precio_base, capacidad, disponible=True):\n",
    "\n",
    "        super().__init__(id_servicio, nombre, descripcion, precio_base)\n",
    "\n",
    "        self.__capacidad = capacidad\n",
    "        self.__disponible = disponible\n",
    "\n",
    "        self.validar_datos()\n",
    "\n",
    "    # Validación de los parámetros específicos\n",
    "    def validar_parametros(self):\n",
    "\n",
    "        if not isinstance(self.__capacidad, int) or isinstance(self.__capacidad, bool) or self.__capacidad <= 0:\n",
    "            raise ServicioNoDisponibleError(\"La capacidad de la sala debe ser un entero mayor que cero.\")\n",
    "\n",
    "        if not isinstance(self.__disponible, bool):\n",
    "            raise ClienteInvalidoError(\"El estado de disponibilidad debe ser verdadero o falso.\")\n",
    "\n",
    "    # Getter de capacidad\n",
    "    def get_capacidad(self):\n",
    "        return self.__capacidad\n",
    "\n",
    "    # Getter de disponibilidad\n",
    "    def get_disponible(self):\n",
    "        return self.__disponible\n",
    "\n",
    "    # Setter de disponibilidad\n",
    "    def set_disponible(self, estado):\n",
    "\n",
    "        if not isinstance(estado, bool):\n",
    "            raise ClienteInvalidoError(\"El estado de disponibilidad debe ser booleano.\")\n",
    "\n",
    "        self.__disponible = estado\n",
    "\n",
    "    # Cálculo del costo de alquiler de la sala\n",
    "    def calcular_costo(self, duracion=1, impuesto=0, descuento=0):\n",
    "\n",
    "        if not isinstance(duracion, (int, float)) or isinstance(duracion, bool) or duracion <= 0:\n",
    "            raise CalculoInconsistenteError(\"La duración de la reserva debe ser mayor que cero.\")\n",
    "\n",
    "        if not self.__disponible:\n",
    "            raise ServicioNoDisponibleError(\"La sala seleccionada no se encuentra disponible.\")\n",
    "\n",
    "        costo_base = self._precio_base * duracion\n",
    "\n",
    "        return self.aplicar_ajustes(costo_base, impuesto, descuento)\n",
    "\n",
    "    # Descripción particular del servicio\n",
    "    def describir_servicio(self):\n",
    "        return (\n",
    "            f\"Reserva de sala: {self._nombre}. \"\n",
    "            f\"Capacidad máxima: {self.__capacidad} personas. \"\n",
    "            f\"Precio por hora: ${self._precio_base}.\"\n",
    "        )\n",
    "\n",
    "    # Información completa de la sala\n",
    "    def mostrar_informacion(self):\n",
    "        return (\n",
    "            f\"ReservaSala [ID: {self._id_entidad} | \"\n",
    "            f\"Nombre: {self._nombre} | \"\n",
    "            f\"Capacidad: {self.__capacidad} personas | \"\n",
    "            f\"Precio por hora: ${self._precio_base} | \"\n",
    "            f\"Disponible: {self.__disponible}]\"\n",
    "        )\n",
    "\n",
    "# ==============================================================================\n",
    "# SIMULACIONES 3 Y 4 - MÓDULO 2\n",
    "# ==============================================================================\n",
    "\n",
    "print(\"\\n==============================================================\")\n",
    "print(\" SIMULACIONES DEL MÓDULO 2 - RESERVA DE SALA\")\n",
    "print(\"==============================================================\")\n",
    "\n",
    "\n",
    "# SIMULACIÓN 3: Creación correcta de una sala\n",
    "try:\n",
    "\n",
    "    sala_1 = ReservaSala(\n",
    "        \"S001\",\n",
    "        \"Sala de conferencias\",\n",
    "        \"Sala equipada para reuniones empresariales\",\n",
    "        80000,\n",
    "        30,\n",
    "        True\n",
    "    )\n",
    "\n",
    "    lista_servicios.append(sala_1)\n",
    "\n",
    "    print(\"[SIMULACIÓN 3 - EXITOSA]\")\n",
    "    print(sala_1.mostrar_informacion())\n",
    "    print(sala_1.describir_servicio())\n",
    "\n",
    "    registrar_log(\n",
    "        \"EVENTO_SERVICIO\",\n",
    "        f\"Creación exitosa: {sala_1.mostrar_informacion()}\"\n",
    "    )\n",
    "\n",
    "except SoftwareFJError as error:\n",
    "\n",
    "    print(f\"[ERROR SIMULACIÓN 3]: {error}\")\n",
    "    registrar_log(\"ERROR_SERVICIO\", str(error))\n",
    "\n",
    "\n",
    "# SIMULACIÓN 4: Creación incorrecta de una sala\n",
    "try:\n",
    "\n",
    "    sala_invalida = ReservaSala(\n",
